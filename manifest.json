{
    "name": "仿素记日记",
    "short_name": "仿素记",
    "description": "本地优先的离线笔记 PWA：数据只存在你的设备上，支持富文本编辑、回收站、自动快照备份与离线自检。",
    "id": "./",
    "start_url": "./?source=pwa",
    "scope": "./",
    "display": "standalone",
    "display_override": [
        "standalone",
        "minimal-ui",
        "browser"
    ],
    "background_color": "#5D5CDE",
    "theme_color": "#5D5CDE",
    "orientation": "portrait",
    "lang": "zh-CN",
    "dir": "ltr",
    "prefer_related_applications": false,
    "categories": [
        "productivity",
        "utilities",
        "lifestyle"
    ],
    "icons": [
        {
            "src": "icons/icon.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        },
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png",
            "purpose": "any"
        }
    ],
    "shortcuts": [
        {
            "name": "新建笔记",
            "short_name": "新建",
            "description": "直接开始记录一条新笔记",
            "url": "./?action=new",
            "icons": [
                {
                    "src": "icons/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ]
}
